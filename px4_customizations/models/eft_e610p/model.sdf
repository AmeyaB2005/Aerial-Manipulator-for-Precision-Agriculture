<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="eft_e610p">
    <!-- Spawn at Z=0.35m to let the landing gear sit on the ground -->
    <pose>0 0 0.35 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Base Link with custom frame.STL visual centered, scaled, and rotated -->
    <link name="base_link">
      <inertial>
        <mass>5.92</mass>
        <inertia>
          <ixx>0.0947</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0947</iyy>
          <iyz>0</iyz>
          <izz>0.1658</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      
      <!-- Simplified Frame Visuals -->
      <visual name="hub_visual">
        <pose>0 0 0.08 0 0 0</pose>
