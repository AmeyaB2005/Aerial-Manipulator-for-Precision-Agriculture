        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
      <!-- Collision representation -->
      <collision name="tank_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.38 0.38 0.18</size>
          </box>
        </geometry>
      </collision>
      </link>

    <joint name="tank_joint" type="fixed">
      <parent>base_link</parent>
      <child>tank_link</child>
    </joint>

    <!-- Rotor 0 (CW, Left) -->
    <link name="rotor_0">
      <pose>0 0.7035 0.1 0 0 0</pose>
      <inertial>
        <mass>0.79</mass>
        <inertia>
          <ixx>2.0e-05</ixx>
